---
interface Props {
  index: number; // Determina la alternancia entre imagen y texto.
  title: string;
  description: string;
  imageUrl: string;
}

const { index, title, description, imageUrl } = Astro.props;
const isEven = index % 2 === 0;
---

<section class:list={["hobby-section", { "reverse": !isEven }]}>
  <!-- Bloque de imagen con degradado. -->
  <div 
    class="image-wrapper" 
    style={`background-image: url('${imageUrl}');`}
  >
    <div class="gradient-overlay"></div>
  </div>

  <!-- Bloque de contenido. -->
  <div class="content-wrapper">
    <div class="text-content">
      <h2>{title}</h2>
      <p>{description}</p>
    </div>
  </div>
</section>

<style>
  .hobby-section {
    width: 100vw;
    height: 50vh; /* Altura de la sección. */
    min-height: 400px;
    position: relative;
    left: 50%;
    right: 50%;
    margin-left: -50vw;
    margin-right: -50vw;
    
    display: flex;
    flex-direction: row; /* Imagen a la izquierda y texto a la derecha. */
    background-color: var(--bg-secondary); 
    overflow: hidden;
  }

  /* Alterna el orden de imagen y texto. */
  .hobby-section.reverse {
    flex-direction: row-reverse;
  }

  .image-wrapper {
    flex: 1.2; /* Ocupa un poco más de la mitad */
    background-size: cover;
    background-position: center;
    position: relative;
  }

  /* Degradado de la imagen hacia el contenido. */
  .gradient-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to right, transparent 50%, var(--bg-secondary) 100%);
  }

  .hobby-section.reverse .gradient-overlay {
    background: linear-gradient(to left, transparent 50%, var(--bg-secondary) 100%);
  }

  .content-wrapper {
    flex: 1; /* Ocupa el espacio restante */
    display: flex;
    align-items: center;
    padding: 3rem;
    box-sizing: border-box;
    z-index: 2;
  }

  .text-content {
    max-width: 450px;
    margin: 0 auto;
  }

  .hobby-section.reverse .text-content {
    margin-left: 0;
    margin-right: auto;
  }

  h2 {
    color: var(--accent-primary);
    font-size: 2.2rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin: 0 0 1rem 0;
  }

  p {
    color: var(--text-secondary);
    font-size: 1.1rem;
    line-height: 1.6;
    margin: 0;
  }

  @media (max-width: 768px) {
    .hobby-section, .hobby-section.reverse {
      flex-direction: column;
      height: auto;
    }
    .image-wrapper {
      height: 250px;
      flex: none;
      width: 100%;
    }
    .gradient-overlay {
      background: linear-gradient(to bottom, transparent 45%, var(--bg-secondary) 100%);
    }
    .content-wrapper {
      padding: 2rem;
    }
  }
</style>
