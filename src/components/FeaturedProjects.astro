---
import ProjectCard from './ProjectCard.astro';

interface Project {
  title: string;
  description: string;
  tags: string[];
  repoUrl?: string;
  demoUrl?: string;
  year?: string;
}

interface Props {
  projects?: Project[];
}

const defaultProjects: Project[] = [
  {
    title: 'Clasificador de imágenes médicas con ViT',
    description: 'Fine-tuning de Vision Transformers y aumento de datos para detectar anomalías en imágenes médicas; enfocado en comparar sensibilidad y rendimiento del modelo.',
    tags: ['PyTorch', 'Vision Transformers', 'Python', 'Computer Vision'],
    repoUrl: 'https://github.com/JanHernandezLlobet/proyecto-vit',
    year: '2026',
  },
  {
    title: 'Sistema RAG sobre documentación técnica',
    description: 'Pipeline de recuperación con embeddings locales y búsqueda híbrida para obtener respuestas trazables sobre documentación técnica.',
    tags: ['LLM', 'RAG', 'LangChain', 'Vector DB'],
    repoUrl: 'https://github.com/JanHernandezLlobet/rag-docs',
    year: '2025',
  },
  {
    title: 'Algoritmos de búsqueda en grafos',
    description: 'Implementación y comparación de A*, Dijkstra y búsqueda bidireccional para analizar rendimiento en mapas reales.',
    tags: ['C++', 'Algoritmos', 'Optimización'],
    repoUrl: 'https://github.com/JanHernandezLlobet/graph-search',
    year: '2025',
  },
];

const { projects = defaultProjects } = Astro.props;
---

<section class="featured-section" aria-labelledby="featured-title">
  <header class="section-heading">
    <div>
      <p class="eyebrow">Selección de trabajo</p>
      <h2 id="featured-title">Proyectos destacados</h2>
    </div>
    <a class="all-projects" href="/proyectos/">Ver todos los proyectos <span aria-hidden="true">→</span></a>
  </header>
  <div class="projects-grid">
    {projects.map((project) => <ProjectCard {...project} />)}
  </div>
</section>

<style>
  .featured-section { margin: 3.5rem 0; }
  .section-heading { display: flex; justify-content: space-between; align-items: flex-end; gap: 1rem; margin-bottom: 1.25rem; }
  .eyebrow { margin: 0 0 .45rem; color: var(--accent-primary); font-size: .75rem; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; }
  h2 { margin: 0; color: var(--text-primary); font-size: clamp(1.6rem, 3vw, 2rem); letter-spacing: -.03em; }
  .all-projects { color: var(--accent-primary); font-size: .9rem; font-weight: 600; text-decoration: none; }
  .all-projects:hover { text-decoration: underline; }
  .all-projects span { display: inline-block; transition: transform .2s ease; }
  .all-projects:hover span { transform: translateX(3px); }
  .projects-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 250px), 1fr)); gap: 1rem; }
  @media (max-width: 560px) { .section-heading { align-items: flex-start; flex-direction: column; } }
</style>
