---
import Layout from '../../layouts/Layout.astro';
import ProjectCard from '../ProjectCard.astro';
import { getLangFromUrl, useTranslations, type Locale } from '../../i18n/utils';

interface Props { lang?: Locale }
const { lang = getLangFromUrl(Astro.url) } = Astro.props;
const t = useTranslations(lang);
const projects = t.featured.projects;
---

<Layout title={`${t.projectsPage.title} | Jan Hernandez`} description={t.projectsPage.description} lang={lang}>
  <header class="page-heading">
    <p class="eyebrow">Jan Hernandez</p>
    <h1>{t.projectsPage.title}</h1>
    <p class="intro">{t.projectsPage.description}</p>
  </header>
  <section class="projects-grid" aria-label={t.projectsPage.title}>
    {projects.map((project) => <ProjectCard {...project} lang={lang} />)}
  </section>
</Layout>

<style>
  .page-heading { margin-bottom: 2rem; }
  .eyebrow { margin: 0 0 .5rem; color: var(--accent-primary); font-size: .75rem; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; }
  h1 { margin: 0; color: var(--text-primary); font-size: clamp(2rem, 5vw, 3rem); letter-spacing: -.035em; }
  .intro { margin: .75rem 0 0; color: var(--text-secondary); }
  .projects-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 280px), 1fr)); gap: 1.5rem; }
</style>
