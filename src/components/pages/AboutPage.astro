---
import Layout from '../../layouts/Layout.astro';
import HobbySection from '../HobbySection.astro';
import { getLangFromUrl, useTranslations, type Locale } from '../../i18n/utils';

interface Props { lang?: Locale }
const { lang = getLangFromUrl(Astro.url) } = Astro.props;
const t = useTranslations(lang);
const imageUrls = ['/images/cirque.jpg', '/images/codigo.jpg', '/images/drone.JPG'];
const hobbies = t.about.hobbies.map((hobby, index) => ({ ...hobby, imageUrl: imageUrls[index] }));
---

<Layout title={`${t.about.title} | Jan Hernandez`} description={t.about.description} lang={lang}>
  <div class="about-page">
    <section id="hobbies" class="hobbies" aria-label={t.about.hobbiesTitle}>
      {hobbies.map((hobby, index) => (
        <HobbySection index={index} title={hobby.title} description={hobby.description} imageUrl={hobby.imageUrl} />
      ))}
    </section>
    <section class="closing-note" aria-label={t.about.closingEyebrow}>
      <p class="eyebrow">{t.about.closingEyebrow}</p>
      <p>{t.about.closing}</p>
    </section>
  </div>
</Layout>

<style>
  .about-page { width: min(1200px, calc(100vw - 3rem)); position: relative; left: 50%; transform: translateX(-50%); }
  .hobbies { scroll-margin-top: 2rem; }
  .closing-note { max-width: 720px; margin: 1rem auto 2rem; padding: 2rem 1rem; text-align: center; }
  .eyebrow { margin: 0 0 .65rem; color: var(--accent-primary); font: 600 .78rem/1.4 system-ui, sans-serif; letter-spacing: .1em; text-transform: uppercase; }
  .closing-note > p:last-child { margin: 0; color: var(--text-secondary); font-size: 1.05rem; line-height: 1.8; }
  @media (max-width: 640px) { .about-page { width: calc(100vw - 2rem); } }
</style>
