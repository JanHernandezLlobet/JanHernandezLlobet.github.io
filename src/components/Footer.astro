---
const currentYear = new Date().getFullYear();
---

<footer>
  <div class="container">
    <p>&copy; {currentYear} Jan Hernandez Llobet</p>
    <div class="links">
      <a href="https://github.com/JanHernandezLlobet" target="_blank" rel="noopener noreferrer">GitHub</a>
    </div>
  </div>
</footer>

<style>
  footer {
    border-top: 1px solid #e5e7eb;
    padding: 2rem;
    margin-top: 4rem;
    color: #6b7280;
    font-size: 0.9rem;
  }
  .container {
    max-width: 900px;
    margin: 0 auto;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  a {
    color: #4b5563;
    text-decoration: none;
  }
  a:hover {
    text-decoration: underline;
  }
</style>