---
import { getLangFromUrl, useTranslations, type Locale } from '../i18n/utils';

interface StatusMeta {
  label: string;
  value: string;
}

interface Props {
  lang?: Locale;
  status?: string;
  metadata?: StatusMeta[];
  focusAreas?: string[];
}

const { lang = getLangFromUrl(Astro.url), status: statusOverride, metadata: metadataOverride, focusAreas: focusAreasOverride } = Astro.props;
const t = useTranslations(lang);
const status = statusOverride ?? t.status.message;
const metadata = metadataOverride ?? [
  { label: t.status.availability, value: t.status.availabilityValue },
  { label: t.status.location, value: t.status.locationValue },
];
const focusAreas = focusAreasOverride ?? t.status.focusAreas;

const actions = [
  { label: t.buttons.downloadCv, href: '/cv-fr.pdf', kind: 'primary', download: true },
  { label: t.buttons.contact, href: '#contacto', kind: 'secondary', download: false },
];
---

<section class="status-section" aria-labelledby="status-title">
  <div class="status-card">
    <div class="status-main">
      <p class="eyebrow">{t.status.eyebrow}</p>
      <h2 id="status-title"><span class="availability-dot" aria-hidden="true"></span>{status}</h2>
      <dl class="metadata">
        {metadata.map((item) => (
          <div>
            <dt>{item.label}</dt>
            <dd>{item.value}</dd>
          </div>
        ))}
      </dl>
      <div class="focus-areas" aria-label={t.status.focus}>
        {focusAreas.map((area) => <span>{area}</span>)}
      </div>
    </div>
    <div class="actions">
      {actions.map((action) => (
        <a class:list={['button', action.kind]} href={action.href} download={action.download ? true : undefined}>
          {action.label}
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .status-section { margin: 1rem 0 3rem; }
  .status-card { display: flex; justify-content: space-between; align-items: flex-end; gap: 2rem; padding: clamp(1.25rem, 4vw, 2rem); background: var(--bg-secondary); border: 1px solid var(--border-color); border-radius: 1rem; }
  .eyebrow { margin: 0 0 .7rem; color: var(--accent-primary); font-size: .75rem; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; }
  h2 { display: flex; align-items: flex-start; gap: .7rem; max-width: 42rem; margin: 0; color: var(--text-primary); font-size: clamp(1.2rem, 2.6vw, 1.65rem); line-height: 1.4; }
  .availability-dot { flex: 0 0 .65rem; width: .65rem; height: .65rem; margin-top: .55rem; border-radius: 50%; background: var(--accent-secondary); box-shadow: 0 0 0 .25rem var(--bg-primary); animation: availability-pulse 1.8s ease-in-out infinite; }
  @keyframes availability-pulse { 50% { opacity: .45; } }
  @media (prefers-reduced-motion: reduce) { .availability-dot { animation: none; } }
  .metadata { display: flex; flex-wrap: wrap; gap: 1.5rem 2.5rem; margin: 1.5rem 0 1.2rem; }
  .metadata div { display: grid; gap: .25rem; }
  dt { color: var(--text-secondary); font-size: .78rem; }
  dd { margin: 0; color: var(--text-primary); font-size: .92rem; font-weight: 600; }
  .focus-areas { display: flex; flex-wrap: wrap; gap: .5rem; }
  .focus-areas span { padding: .3rem .6rem; border: 1px solid var(--border-color); border-radius: 999px; color: var(--text-secondary); font-family: monospace; font-size: .75rem; }
  .actions { display: flex; flex: 0 0 auto; flex-wrap: wrap; gap: .7rem; }
  .button { display: inline-flex; justify-content: center; align-items: center; min-height: 2.75rem; padding: .65rem 1rem; border: 1px solid var(--accent-primary); border-radius: .55rem; font-size: .9rem; font-weight: 650; text-decoration: none; transition: background-color .2s ease, color .2s ease; }
  .primary { background: var(--accent-primary); color: var(--bg-primary); }
  .primary:hover { opacity: .88; }
  .secondary { background: transparent; color: var(--accent-primary); }
  .secondary:hover { background: var(--bg-primary); }
  @media (max-width: 700px) { .status-card { align-items: flex-start; flex-direction: column; } }
</style>
