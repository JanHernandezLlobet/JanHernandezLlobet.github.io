---
import { getLangFromUrl, useTranslations, type Locale } from '../i18n/utils';

interface Category {
  name: string;
  technologies: string[];
}

interface Props {
  lang?: Locale;
  categories?: Category[];
}

const { lang = getLangFromUrl(Astro.url), categories: categoryOverride } = Astro.props;
const t = useTranslations(lang);
const categories = categoryOverride ?? t.tech.categories;
---

<section class="stack-section" aria-labelledby="stack-title">
  <header class="section-heading">
    <p class="eyebrow">{t.tech.eyebrow}</p>
    <h2 id="stack-title">{t.tech.title}</h2>
  </header>
  <div class="category-grid">
    {categories.map((category) => (
      <article class="category-card">
        <h3>{category.name}</h3>
        <ul>
          {category.technologies.map((technology) => <li>{technology}</li>)}
        </ul>
      </article>
    ))}
  </div>
</section>

<style>
  .stack-section { margin: 3.5rem 0; }
  .section-heading { margin-bottom: 1.25rem; }
  .eyebrow { margin: 0 0 .45rem; color: var(--accent-primary); font-size: .75rem; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; }
  h2 { margin: 0; color: var(--text-primary); font-size: clamp(1.6rem, 3vw, 2rem); letter-spacing: -.03em; }
  .category-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1rem; }
  .category-card { padding: 1.25rem; border: 1px solid var(--border-color); border-radius: .8rem; background: var(--bg-primary); }
  h3 { margin: 0 0 1rem; color: var(--text-primary); font-size: 1rem; }
  ul { display: flex; flex-wrap: wrap; gap: .5rem; margin: 0; padding: 0; list-style: none; }
  li { padding: .35rem .55rem; border: 1px solid var(--border-color); border-radius: .45rem; background: var(--bg-secondary); color: var(--text-secondary); font: .75rem/1.4 monospace; }
  @media (max-width: 720px) { .category-grid { grid-template-columns: 1fr; } }
</style>
