---
import ThemeToggle from '../components/ThemeToggle.astro';
import { getLocalizedPath, getLangFromUrl, locales, useTranslations, type Locale } from '../i18n/utils';

interface Props { lang?: Locale }
const { lang = getLangFromUrl(Astro.url) } = Astro.props;
const t = useTranslations(lang);
const localePrefix = new RegExp(`^/(${locales.join('|')})(?=/|$)`);
const currentPath = Astro.url.pathname.replace(localePrefix, '') || '/';
const normalizedPath = currentPath.endsWith('/') ? currentPath : `${currentPath}/`;
const navigation = [
  { label: t.nav.home, path: '/' },
  { label: t.nav.projects, path: '/proyectos/' },
  { label: t.nav.about, path: '/sobre-mi/' },
];
const localeNames: Record<Locale, string> = { es: 'ES', fr: 'FR', en: 'EN' };
---

<header>
  <nav>
    <a href={getLocalizedPath('/', lang)} class="logo">Jan Hernandez</a>
    <ul>
      {navigation.map((item) => (
        <li><a href={getLocalizedPath(item.path, lang)} class={normalizedPath === item.path ? 'active' : ''}>{item.label}</a></li>
      ))}
      <li class="language-control" aria-label={t.nav.language}>
        {locales.map((locale) => (
          <a href={getLocalizedPath(Astro.url.pathname, locale)} lang={locale} aria-current={locale === lang ? 'page' : undefined} class={locale === lang ? 'selected-language' : ''}>{localeNames[locale]}</a>
        ))}
      </li>
      <li class="theme-control"><ThemeToggle lang={lang} /></li>
    </ul>
  </nav>
</header>

<style>
  header {
    border-bottom: 1px solid var(--border-color);
    padding: 1rem 2rem;
    background: var(--bg-primary);
  }
  nav {
    max-width: 900px;
    margin: 0 auto;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .logo {
    font-weight: bold;
    text-decoration: none;
    color: var(--text-primary);
  }
  ul {
    list-style: none;
    display: flex;
    gap: 1.5rem;
    margin: 0;
    padding: 0;
  }
  a {
    text-decoration: none;
    color: var(--text-secondary);
  }
  a:hover, a.active {
    color: var(--accent-primary);
    font-weight: 600;
  }
  .theme-control { display: flex; align-items: center; }
  .language-control { display: flex; align-items: center; gap: .35rem; color: var(--text-secondary); font-size: .78rem; }
  .language-control a { color: var(--text-secondary); }
  .language-control a.selected-language { color: var(--accent-primary); font-weight: 700; }
  .language-control a + a::before { content: '|'; margin-right: .35rem; color: var(--border-color); font-weight: 400; }
  @media (max-width: 560px) {
    header { padding: 1rem; }
    nav { align-items: flex-start; gap: 1rem; }
    ul { flex-wrap: wrap; justify-content: flex-end; gap: .8rem; }
  }
</style>
