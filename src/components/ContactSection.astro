---
interface ContactLink {
  label: string;
  href: string;
  external?: boolean;
}

interface Props {
  email?: string;
  linkedinUrl?: string;
  links?: ContactLink[];
}

const {
  // Sustituye estos dos valores por tus datos públicos antes de publicar.
  email = 'tu.email@ejemplo.com',
  linkedinUrl = 'https://www.linkedin.com/in/tu-perfil/',
} = Astro.props;

const contactLinks: ContactLink[] = [
  { label: 'GitHub', href: 'https://github.com/JanHernandezLlobet', external: true },
  { label: 'LinkedIn', href: linkedinUrl, external: true },
];

const { links = contactLinks } = Astro.props;
---

<section id="contacto" class="contact-section" aria-labelledby="contact-title">
  <div class="hobby-banner">
    <p>Fuera del trabajo</p>
    <a href="/sobre-mi/#hobbies">Más allá del código: descubre mis hobbies <span aria-hidden="true">→</span></a>
  </div>
  <div class="contact-card">
    <div>
      <p class="eyebrow">Hablemos</p>
      <h2 id="contact-title">¿Tienes un proyecto en mente?</h2>
      <p class="email-address">{email}</p>
    </div>
    <div class="contact-actions">
      <a class="email-link" href={`mailto:${email}`}>Escribir un correo</a>
      <button class="copy-button" type="button" data-email={email}>Copiar email</button>
      <span class="copy-status" role="status" aria-live="polite"></span>
    </div>
    <nav class="social-links" aria-label="Perfiles profesionales">
      {links.map((link) => (
        <a href={link.href} target={link.external ? '_blank' : undefined} rel={link.external ? 'noopener noreferrer' : undefined}>
          {link.label} <span aria-hidden="true">↗</span>
        </a>
      ))}
    </nav>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLButtonElement>('.copy-button').forEach((button) => {
    button.addEventListener('click', async () => {
      const status = button.parentElement?.querySelector<HTMLElement>('.copy-status');
      const email = button.dataset.email ?? '';
      try {
        await navigator.clipboard.writeText(email);
        if (status) status.textContent = 'Email copiado';
        button.textContent = 'Copiado';
        window.setTimeout(() => { button.textContent = 'Copiar email'; if (status) status.textContent = ''; }, 2200);
      } catch {
        if (status) status.textContent = 'No se pudo copiar. Selecciona el email para copiarlo.';
      }
    });
  });
</script>

<style>
  .contact-section { margin: 3.5rem 0 1rem; }
  .hobby-banner { display: flex; justify-content: space-between; align-items: center; gap: 1rem; margin-bottom: 1rem; padding: 1rem 1.25rem; border: 1px solid var(--border-color); border-radius: .75rem; background: var(--bg-secondary); }
  .hobby-banner p { margin: 0; color: var(--text-secondary); font-size: .88rem; }
  a { color: var(--accent-primary); font-weight: 600; text-decoration: none; }
  a:hover { text-decoration: underline; }
  .hobby-banner a { font-size: .9rem; }
  .contact-card { display: grid; grid-template-columns: 1fr auto; align-items: center; gap: 1rem 2rem; padding: clamp(1.25rem, 4vw, 2rem); border: 1px solid var(--border-color); border-radius: 1rem; background: var(--bg-primary); }
  .eyebrow { margin: 0 0 .45rem; color: var(--accent-primary); font-size: .75rem; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; }
  h2 { margin: 0; color: var(--text-primary); font-size: clamp(1.35rem, 3vw, 1.8rem); }
  .email-address { margin: .5rem 0 0; color: var(--text-secondary); }
  .contact-actions { display: flex; flex-wrap: wrap; align-items: center; gap: .6rem; }
  .email-link, .copy-button { display: inline-flex; align-items: center; justify-content: center; min-height: 2.65rem; padding: .55rem .85rem; border: 1px solid var(--accent-primary); border-radius: .5rem; background: transparent; color: var(--accent-primary); font: 600 .85rem system-ui, sans-serif; text-decoration: none; cursor: pointer; }
  .email-link { background: var(--accent-primary); color: var(--bg-primary); }
  .copy-button:hover { background: var(--bg-secondary); }
  .copy-status { width: 100%; color: var(--accent-secondary); font-size: .8rem; }
  .social-links { grid-column: 1 / -1; display: flex; gap: 1.25rem; padding-top: 1rem; border-top: 1px solid var(--border-color); font-size: .9rem; }
  @media (max-width: 640px) { .hobby-banner { align-items: flex-start; flex-direction: column; } .contact-card { grid-template-columns: 1fr; } .social-links { grid-column: auto; } }
</style>
