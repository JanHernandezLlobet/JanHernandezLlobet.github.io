---
import Layout from '../layouts/Layout.astro';

const hobbies = [
  {
    number: '01',
    title: 'Un hobby que disfruto',
    description: 'Cuenta aquí qué te gusta hacer, cómo empezaste y qué es lo que más disfrutas de esta actividad.',
    imageLabel: 'Añade una foto panorámica para este hobby',
    imagePath: '/images/hobby-01-portada.jpg',
    extraImages: ['/images/hobby-01-1.jpg', '/images/hobby-01-2.jpg', '/images/hobby-01-3.jpg'],
  },
  {
    number: '02',
    title: 'Otra de mis pasiones',
    description: 'Describe otro hobby con una anécdota, un lugar especial o algo que hayas aprendido gracias a él.',
    imageLabel: 'Añade una foto panorámica para este hobby',
    imagePath: '/images/hobby-02-portada.jpg',
    extraImages: ['/images/hobby-02-1.jpg', '/images/hobby-02-2.jpg', '/images/hobby-02-3.jpg'],
  },
  {
    number: '03',
    title: 'Algo que me inspira',
    description: 'Puedes usar este espacio para compartir una tercera afición y lo que aporta a tu día a día.',
    imageLabel: 'Añade una foto panorámica para este hobby',
    imagePath: '/images/hobby-03-portada.jpg',
    extraImages: ['/images/hobby-03-1.jpg', '/images/hobby-03-2.jpg', '/images/hobby-03-3.jpg'],
  },
];
---

<Layout title="Sobre mí | Jan Hernandez" description="Conoce un poco más sobre Jan y sus hobbies">
  <div class="about-page">
    <section class="intro" aria-labelledby="about-title">
      <div class="portrait-placeholder" role="img" aria-label="Espacio reservado para una foto de Jan">
        <svg viewBox="0 0 64 64" aria-hidden="true">
          <circle cx="32" cy="22" r="12" />
          <path d="M10 57c1-13 10-20 22-20s21 7 22 20" />
        </svg>
        <span>Tu foto aquí</span>
        <small>Guárdala en <code>public/images/</code> y sustituye este espacio</small>
      </div>
      <div class="intro-copy">
        <p class="eyebrow">Un poco sobre mí</p>
        <h1 id="about-title">¡Hola, soy Jan!</h1>
        <p class="lead">Esta página es una pequeña ventana a las cosas que me gustan y a cómo disfruto mi tiempo fuera de los proyectos.</p>
        <a class="scroll-link" href="#hobbies">Sigue leyendo <span aria-hidden="true">↓</span></a>
      </div>
    </section>

    <section id="hobbies" class="hobbies" aria-labelledby="hobbies-title">
      <header class="section-heading">
        <p class="eyebrow">Fuera de la pantalla</p>
        <h2 id="hobbies-title">Mis hobbies</h2>
        <p>Desliza para descubrir algunas de las cosas que disfruto.</p>
      </header>

      {hobbies.map((hobby) => (
        <article class="hobby-section">
          <div class="hobby-cover" style={`--cover-image: url('${hobby.imagePath}')`} role="img" aria-label={hobby.imageLabel}>
            <div class="cover-content">
              <span class="image-number">{hobby.number}</span>
              <h3>{hobby.title}</h3>
              <span class="image-label">Añade aquí la foto de portada</span>
            </div>
          </div>
          <div class="hobby-details">
            <div class="hobby-copy">
              <p class="eyebrow">Hobby {hobby.number}</p>
              <p>{hobby.description}</p>
            </div>
            <div class="hobby-gallery" aria-label={`Más fotos: ${hobby.title}`}>
              {hobby.extraImages.map((imagePath, index) => (
                <div class="gallery-placeholder" style={`--gallery-image: url('${imagePath}')`} role="img" aria-label={`Añade la foto ${index + 1} de ${hobby.title}`}>
                  <span>Foto {index + 1}</span>
                </div>
              ))}
            </div>
          </div>
        </article>
      ))}
    </section>
  </div>
</Layout>

<style>
  .about-page { --ink: #111827; --muted: #4b5563; --accent: #2563eb; width: min(1200px, calc(100vw - 3rem)); position: relative; left: 50%; transform: translateX(-50%); }
  .intro { display: grid; grid-template-columns: minmax(230px, 0.85fr) 1.15fr; align-items: center; gap: clamp(2rem, 7vw, 5rem); padding: 1rem 0 5rem; }
  .portrait-placeholder { min-height: 330px; padding: 1.5rem; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: .8rem; text-align: center; color: var(--muted); background: linear-gradient(145deg, #eff6ff, #f3f4f6); border: 1px dashed #cbd5e1; border-radius: 1.25rem; }
  .portrait-placeholder svg { width: 72px; fill: none; stroke: #94a3b8; stroke-width: 3; stroke-linecap: round; }
  .portrait-placeholder span { color: var(--ink); font-weight: 650; font-size: 1.1rem; }
  .portrait-placeholder small { max-width: 230px; line-height: 1.5; }
  code { font-family: monospace; }
  .eyebrow { margin: 0 0 .65rem; color: var(--accent); font: 600 .78rem/1.4 system-ui, sans-serif; letter-spacing: .1em; text-transform: uppercase; }
  h1, h2, h3 { color: var(--ink); letter-spacing: -.035em; }
  h1 { margin: 0; font-size: clamp(2.5rem, 6vw, 4rem); line-height: 1.05; }
  .lead { max-width: 38rem; margin: 1.25rem 0 1.75rem; color: var(--muted); font-size: 1.15rem; line-height: 1.8; }
  .scroll-link { color: var(--accent); font-weight: 600; text-decoration: none; }
  .scroll-link span { display: inline-block; margin-left: .35rem; transition: transform .2s ease; }
  .scroll-link:hover span { transform: translateY(3px); }
  .hobbies { scroll-margin-top: 2rem; padding: 1.5rem 0 2rem; }
  .section-heading { margin: 0 auto 3rem; text-align: center; }
  .section-heading h2 { margin: 0; font-size: clamp(2rem, 4vw, 3rem); }
  .section-heading > p:last-child { color: var(--muted); }
  .hobby-section { margin: 0 0 4rem; }
  .hobby-cover { min-height: clamp(340px, 48vw, 540px); display: flex; align-items: flex-end; overflow: hidden; color: white; background-image: linear-gradient(to top, rgba(17, 24, 39, .96) 0%, rgba(17, 24, 39, .58) 28%, rgba(17, 24, 39, .08) 72%), var(--cover-image), linear-gradient(135deg, #dbeafe, #e5e7eb 55%, #d1fae5); background-position: center; background-size: cover; border-radius: 1.25rem; }
  .cover-content { width: 100%; padding: clamp(1.5rem, 5vw, 3.5rem); }
  .cover-content h3 { max-width: 850px; margin: .65rem 0; color: white; font-size: clamp(2.2rem, 6vw, 4.5rem); line-height: 1.02; text-shadow: 0 2px 24px rgba(0,0,0,.3); }
  .cover-content .image-number { position: static; color: #e5e7eb; }
  .cover-content .image-label { color: #e5e7eb; font-size: .85rem; }
  .image-number { position: absolute; top: 1rem; left: 1.2rem; color: #94a3b8; font: 500 .8rem monospace; }
  .hobby-details { display: grid; grid-template-columns: minmax(230px, .8fr) 1.2fr; align-items: start; gap: clamp(2rem, 6vw, 5rem); padding: 2rem clamp(.25rem, 2vw, 1.5rem) 0; }
  .hobby-copy > p:last-child { max-width: 34rem; margin: 0; color: var(--muted); line-height: 1.8; }
  .hobby-gallery { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: .8rem; }
  .gallery-placeholder { min-height: 135px; display: flex; align-items: flex-end; padding: .8rem; color: #4b5563; font-size: .8rem; background-image: linear-gradient(to top, rgba(255,255,255,.88), rgba(255,255,255,.08) 65%), var(--gallery-image), linear-gradient(135deg, #eff6ff, #f3f4f6); background-position: center; background-size: cover; border-radius: .8rem; }
  @media (max-width: 640px) {
    .about-page { width: calc(100vw - 2rem); }
    .intro { grid-template-columns: 1fr; gap: 1.5rem; }
    .intro { padding-bottom: 3.5rem; }
    .portrait-placeholder { min-height: 260px; }
    .hobby-section { margin-bottom: 3rem; }
    .hobby-cover { min-height: 320px; border-radius: 1rem; }
    .hobby-details { grid-template-columns: 1fr; gap: 1.5rem; padding: 1.5rem .25rem 0; }
    .hobby-gallery { gap: .5rem; }
    .gallery-placeholder { min-height: 100px; padding: .55rem; font-size: .7rem; }
    .section-heading { margin-bottom: 2rem; }
  }
</style>
