---
import Layout from '../layouts/Layout.astro';
import HobbySection from '../components/HobbySection.astro';

const hobbies = [
  {
    title: 'Senderismo',
    description: 'Explorando rutas de alta montaña y senderos naturales los fines de semana. Perderse en los Pirineos es mi desconexión favorita.',
    imageUrl: '/images/cirque.jpg',
    tagColor: '#c2410c',
  },
  {
    title: 'Codificación',
    description: 'Desarrollando proyectos personales y explorando nuevas tecnologías. Me encanta trastear con inteligencia artificial y automatizaciones.',
    imageUrl: '/images/codigo.jpg',
    tagColor: '#0d9488',
  },
  {
    title: 'Audiovisual con drones',
    description: 'Capturando pequeños instantes, paisajes y la luz natural de las ciudades. La cámara me obliga a mirar el mundo de otra forma.',
    imageUrl: '/images/drone.jpg',
    tagColor: '#2563eb',
  },
];
---

<Layout title="Sobre mí | Jan Hernandez" description="Conoce un poco más sobre Jan y sus hobbies">
  <div class="about-page">
    <section class="intro" aria-labelledby="about-title">
      <div class="portrait-placeholder" role="img" aria-label="Espacio reservado para una foto de Jan">
        <svg viewBox="0 0 64 64" aria-hidden="true">
          <circle cx="32" cy="22" r="12" />
          <path d="M10 57c1-13 10-20 22-20s21 7 22 20" />
        </svg>
        <span>Tu foto aquí</span>
        <small>Guárdala en <code>public/images/</code> y sustituye este espacio</small>
      </div>
      <div class="intro-copy">
        <p class="eyebrow">Un poco sobre mí</p>
        <h1 id="about-title">¡Hola, soy Jan!</h1>
        <p class="lead">Esta página es una pequeña ventana a las cosas que me gustan y a cómo disfruto mi tiempo fuera de los proyectos.</p>
        <a class="scroll-link" href="#hobbies">Sigue leyendo <span aria-hidden="true">↓</span></a>
      </div>
    </section>

    <section id="hobbies" class="hobbies" aria-label="Mis hobbies">
      {hobbies.map((hobby, index) => (
        <HobbySection
          index={index}
          title={hobby.title}
          description={hobby.description}
          imageUrl={hobby.imageUrl}
          tagColor={hobby.tagColor}
        />
      ))}
    </section>

    <section class="closing-note" aria-label="Cierre">
      <p class="eyebrow">Y siempre hay algo nuevo</p>
      <p>Entre rutas, proyectos y nuevos planes, cada afición me da una forma distinta de seguir aprendiendo.</p>
    </section>
  </div>
</Layout>

<style>
  .about-page { --ink: #111827; --muted: #4b5563; --accent: #2563eb; width: min(1200px, calc(100vw - 3rem)); position: relative; left: 50%; transform: translateX(-50%); }
  .intro { display: grid; grid-template-columns: minmax(230px, 0.85fr) 1.15fr; align-items: center; gap: clamp(2rem, 7vw, 5rem); padding: 1rem 0 5rem; }
  .portrait-placeholder { min-height: 330px; padding: 1.5rem; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: .8rem; text-align: center; color: var(--muted); background: linear-gradient(145deg, #eff6ff, #f3f4f6); border: 1px dashed #cbd5e1; border-radius: 1.25rem; }
  .portrait-placeholder svg { width: 72px; fill: none; stroke: #94a3b8; stroke-width: 3; stroke-linecap: round; }
  .portrait-placeholder span { color: var(--ink); font-weight: 650; font-size: 1.1rem; }
  .portrait-placeholder small { max-width: 230px; line-height: 1.5; }
  code { font-family: monospace; }
  .eyebrow { margin: 0 0 .65rem; color: var(--accent); font: 600 .78rem/1.4 system-ui, sans-serif; letter-spacing: .1em; text-transform: uppercase; }
  h1, h2, h3 { color: var(--ink); letter-spacing: -.035em; }
  h1 { margin: 0; font-size: clamp(2.5rem, 6vw, 4rem); line-height: 1.05; }
  .lead { max-width: 38rem; margin: 1.25rem 0 1.75rem; color: var(--muted); font-size: 1.15rem; line-height: 1.8; }
  .scroll-link { color: var(--accent); font-weight: 600; text-decoration: none; }
  .scroll-link span { display: inline-block; margin-left: .35rem; transition: transform .2s ease; }
  .scroll-link:hover span { transform: translateY(3px); }
  .hobbies { scroll-margin-top: 2rem; }
  .closing-note { max-width: 720px; margin: 1rem auto 2rem; padding: 2rem 1rem; text-align: center; }
  .closing-note > p:last-child { margin: 0; color: var(--muted); font-size: 1.05rem; line-height: 1.8; }
  @media (max-width: 640px) {
    .about-page { width: calc(100vw - 2rem); }
    .intro { grid-template-columns: 1fr; gap: 1.5rem; }
    .intro { padding-bottom: 3.5rem; }
    .portrait-placeholder { min-height: 260px; }
  }
</style>
