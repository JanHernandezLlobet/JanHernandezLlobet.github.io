---
import Layout from '../layouts/Layout.astro';
import ProjectCard from '../components/ProjectCard.astro';

const proyectos = [
  {
    title: "Clasificador de Imágenes Médicas con ViT",
    description: "Fine-tuning de Vision Transformers para detección temprana de anomalías utilizando PyTorch y aumento de datos.",
    tags: ["PyTorch", "Vision Transformers", "Python", "Computer Vision"],
    repoUrl: "https://github.com/JanHernandezLlobet/proyecto-vit",
    year: "2026"
  },
  {
    title: "Sistema RAG sobre Documentación Técnica",
    description: "Pipeline de recuperación aumentada con embeddings locales, búsqueda híbrida y evaluación de alucinaciones.",
    tags: ["LLM", "RAG", "LangChain", "Vector DB"],
    repoUrl: "https://github.com/JanHernandezLlobet/rag-docs",
    demoUrl: "https://huggingface.co/spaces/...",
    year: "2025"
  },
  {
    title: "Algoritmos de Búsqueda en Grafos",
    description: "Implementación y comparativa de rendimiento entre A*, Dijkstra y búsqueda bidireccional en mapas reales.",
    tags: ["C++", "Algoritmos", "Optimización"],
    repoUrl: "https://github.com/JanHernandezLlobet/graph-search",
    year: "2025"
  }
];
---

<Layout title="Proyectos | Jan Hernandez" description="Portfolio de proyectos de Inteligencia Artificial y desarrollo">
  <h1>Proyectos</h1>
  <p class="intro">Selección de trabajos técnicos, modelos entrenados y herramientas desarrolladas.</p>

  <section class="projects-grid">
    {proyectos.map((proyecto) => (
      <ProjectCard
        title={proyecto.title}
        description={proyecto.description}
        tags={proyecto.tags}
        repoUrl={proyecto.repoUrl}
        demoUrl={proyecto.demoUrl}
        year={proyecto.year}
      />
    ))}
  </section>
</Layout>

<style>
  .intro {
    color: var(--text-secondary);
    margin-bottom: 2rem;
  }
  .projects-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1.5rem;
  }
</style>
