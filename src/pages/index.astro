---
import Layout from '../layouts/Layout.astro';
import CurrentStatus from '../components/CurrentStatus.astro';
import FeaturedProjects from '../components/FeaturedProjects.astro';
import TechStack from '../components/TechStack.astro';
import Timeline from '../components/Timeline.astro';
import ContactSection from '../components/ContactSection.astro';
---

<Layout title="Inicio | Jan Hernandez" description="Página personal de Jan Hernandez" lang="es">
  <section class="intro" aria-labelledby="about-title">
    <div class="portrait-placeholder" role="img" aria-label="Espacio reservado para una foto de Jan">
      <svg viewBox="0 0 64 64" aria-hidden="true">
        <circle cx="32" cy="22" r="12" />
        <path d="M10 57c1-13 10-20 22-20s21 7 22 20" />
      </svg>
      <span>Tu foto aquí</span>
      <small>Guárdala en <code>public/images/</code> y sustituye este espacio</small>
    </div>
    <div class="intro-copy">
      <p class="eyebrow">Un poco sobre mí</p>
      <h1 id="about-title">¡Hola, soy Jan!</h1>
      <p class="lead">Esta página es una pequeña ventana a las cosas que me gustan y a cómo disfruto mi tiempo fuera de los proyectos.</p>
      <a class="scroll-link" href="/sobre-mi/#hobbies">Descubre mis hobbies <span aria-hidden="true">→</span></a>
    </div>
  </section>

  <CurrentStatus lang="es" />
  <FeaturedProjects lang="es" />
  <TechStack lang="es" />
  <Timeline lang="es" />
  <ContactSection lang="es" />
</Layout>

<style>
  .intro { display: grid; grid-template-columns: minmax(230px, .85fr) 1.15fr; align-items: center; gap: clamp(2rem, 7vw, 5rem); max-width: 1000px; margin: 0 auto; padding: clamp(1rem, 5vw, 4rem) 0; }
  .portrait-placeholder { min-height: 360px; padding: 1.5rem; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: .8rem; text-align: center; color: var(--text-secondary); background: linear-gradient(145deg, var(--bg-secondary), var(--bg-primary)); border: 1px dashed var(--border-color); border-radius: 1.25rem; }
  .portrait-placeholder svg { width: 72px; fill: none; stroke: var(--text-secondary); stroke-width: 3; stroke-linecap: round; }
  .portrait-placeholder span { color: var(--text-primary); font-weight: 650; font-size: 1.1rem; }
  .portrait-placeholder small { max-width: 230px; line-height: 1.5; }
  code { font-family: monospace; }
  .eyebrow { margin: 0 0 .65rem; color: var(--accent-primary); font: 600 .78rem/1.4 system-ui, sans-serif; letter-spacing: .1em; text-transform: uppercase; }
  h1 { margin: 0; color: var(--text-primary); font-size: clamp(2.5rem, 6vw, 4rem); line-height: 1.05; letter-spacing: -.035em; }
  .lead { max-width: 38rem; margin: 1.25rem 0 1.75rem; color: var(--text-secondary); font-size: 1.15rem; line-height: 1.8; }
  .scroll-link { color: var(--accent-primary); font-weight: 600; text-decoration: none; }
  .scroll-link span { display: inline-block; margin-left: .35rem; transition: transform .2s ease; }
  .scroll-link:hover span { transform: translateX(3px); }
  @media (max-width: 640px) {
    .intro { grid-template-columns: 1fr; gap: 1.5rem; padding: .5rem 0 2rem; }
    .portrait-placeholder { min-height: 260px; }
  }
</style>
